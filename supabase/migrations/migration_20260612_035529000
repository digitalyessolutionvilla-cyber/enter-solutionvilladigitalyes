
-- ═══════════════════════════════════════
-- SERVICES TABLE
-- ═══════════════════════════════════════
CREATE TABLE IF NOT EXISTS services (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  icon text NOT NULL DEFAULT 'Globe',
  title text NOT NULL,
  description text,
  tag text,
  sort_order int DEFAULT 0,
  is_active boolean DEFAULT true,
  link_href text DEFAULT '/#services',
  created_at timestamptz DEFAULT now()
);
ALTER TABLE services ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read active services" ON services FOR SELECT USING (true);
CREATE POLICY "Admins can manage services" ON services FOR ALL USING (auth.role() = 'authenticated');


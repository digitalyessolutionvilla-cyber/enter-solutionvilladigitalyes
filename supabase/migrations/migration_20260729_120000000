-- 4. SUPPORT tables → super_admin, admin, support
--    (public INSERT policies for visitor submissions are left untouched)
-- ════════════════════════════════════════════════════════════════════════

-- contact_submissions (select / update only; public insert stays)
DROP POLICY IF EXISTS "Admins can view submissions" ON public.contact_submissions;
DROP POLICY IF EXISTS "Admins can update submissions" ON public.contact_submissions;
CREATE POLICY "Support roles can view submissions" ON public.contact_submissions
  FOR SELECT
  USING (public.current_user_role() IN ('super_admin', 'admin', 'support'));
CREATE POLICY "Support roles can update submissions" ON public.contact_submissions
  FOR UPDATE
  USING (public.current_user_role() IN ('super_admin', 'admin', 'support'))
  WITH CHECK (public.current_user_role() IN ('super_admin', 'admin', 'support'));


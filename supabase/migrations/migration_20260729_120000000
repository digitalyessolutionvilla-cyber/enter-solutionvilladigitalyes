-- chat_leads
--   • Public INSERT/UPDATE stay (the solution-ai-chat backend may write leads
--     via the anon key). SELECT is support-only so lead PII is protected.
DROP POLICY IF EXISTS "Admins can manage leads" ON public.chat_leads;
CREATE POLICY "Support roles can manage leads" ON public.chat_leads
  FOR ALL
  USING (public.current_user_role() IN ('super_admin', 'admin', 'support'))
  WITH CHECK (public.current_user_role() IN ('super_admin', 'admin', 'support'));

-- chat_messages
--   • Public SELECT stays (anonymous visitor restores chat history + realtime).
--   • Public INSERT stays (the solution-ai-chat backend may insert via the
--     anon key; keeping it guarantees the live chat keeps working).
--   • The broad authenticated policy is replaced by a support-scoped one so
--     staff write/modify access is limited to Support/Admin roles.
DROP POLICY IF EXISTS "Admins can manage messages" ON public.chat_messages;
CREATE POLICY "Support roles can manage messages" ON public.chat_messages
  FOR ALL
  USING (public.current_user_role() IN ('super_admin', 'admin', 'support'))
  WITH CHECK (public.current_user_role() IN ('super_admin', 'admin', 'support'));



CREATE TABLE IF NOT EXISTS case_study_gallery (
  id uuid NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
  case_study_id uuid NOT NULL REFERENCES case_studies(id) ON DELETE CASCADE,
  image_url text NOT NULL,
  caption text,
  sort_order integer NOT NULL DEFAULT 0,
  created_at timestamp with time zone DEFAULT now()
);
ALTER TABLE case_study_gallery ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read gallery" ON case_study_gallery FOR SELECT USING (true);
CREATE POLICY "Admins manage gallery" ON case_study_gallery FOR ALL USING (auth.role() = 'authenticated');

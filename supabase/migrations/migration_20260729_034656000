DROP POLICY IF EXISTS "Admins can do all on posts" ON public.blog_posts;
CREATE POLICY "Content roles can manage posts" ON public.blog_posts
  FOR ALL USING (public.current_user_role() IN ('super_admin', 'admin', 'content_editor'))
  WITH CHECK (public.current_user_role() IN ('super_admin', 'admin', 'content_editor'));

